{
  "manifest_version": 3,
  "name": "学习时长追踪器",
  "version": "1.1.0",
  "description": "自动追踪你在不同网站的学习时长,分类统计,并把数据同步给桌面搭子(VPet/companion-desk),给你鼓励。",
  "permissions": ["tabs", "storage", "idle", "alarms", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习时长统计"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
